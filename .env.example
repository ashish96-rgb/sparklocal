# Choose demo, ollama, or huggingface. Demo mode works without credentials.
AI_PROVIDER=demo

# Local open-weight Gemma with Ollama. Install Ollama, then run: ollama pull gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Hosted Gemma through Hugging Face Inference Providers. Accept Gemma's license
# and create a token with inference permissions before enabling this provider.
HF_TOKEN=
HF_MODEL=google/gemma-3-4b-it
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions

PORT=3000